# ==========================================================================
# DIGFIN — contoh konfigurasi PRODUKSI
# Salin ke .env (di server produksi) lalu sesuaikan nilainya.
# JANGAN commit berkas .env yang berisi kredensial asli.
# ==========================================================================

APP_NAME=DIGFIN
APP_ENV=production
# Wajib diisi: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.example

# Origin SPA React yang diizinkan (CORS). Pisahkan dengan koma.
FRONTEND_URL=https://domain-anda.example

# Sanctum memaksa request stateful (cookie/session) dari domain ini.
# PENTING: tanpa protokol, pisahkan dengan koma.
SANCTUM_STATEFUL_DOMAINS=domain-anda.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Rotasi log harian; produksi cukup warning (atau error).
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_SECURITY_DAYS=90

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=digfin
DB_USERNAME=digfin
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Aktifkan verifikasi TLS ke server database.
DB_SSLMODE=require

# Redis untuk cache, queue, dan session di produksi.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di produksi (akses via HTTPS).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Queue via Redis + worker supervisor (php artisan queue:work).
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=digfin_prod_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.domain-anda.example
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@domain-anda.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================================================
# SECURITY (lihat config/security.php)
# ==========================================================================
# WAJIB diganti dengan path rahasia milik Anda (obscurity layer, bukan
# pengganti auth/authorization). Jangan gunakan nilai contoh ini.
ADMIN_PATH=change-me-rahasia-panel-admin

# Kredensial bootstrap admin awal (sekali pakai, DIPAKSA ganti saat login).
# Isi saat seeding pertama, lalu hapus dari .env.
# ADMIN_INITIAL_USERNAME=
# ADMIN_INITIAL_PASSWORD=

ADMIN_MAX_DEVICES=2
ADMIN_SESSION_LIFETIME=120
ADMIN_LIST_PER_PAGE=15

LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_SHORT=1
LOGIN_COOLDOWN_MEDIUM=5
LOGIN_COOLDOWN_LONG=15
LOGIN_COOLDOWN_EXTENDED=30
LOGIN_USERNAME_PROBE_WINDOW=10
LOGIN_MAX_USERNAMES_PER_IP=10
LOGIN_IP_PROBE_WINDOW=15
LOGIN_MAX_IPS_PER_USERNAME=5

PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_HISTORY_COUNT=5

MAX_IMAGE_SIZE=5120
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_HEIGHT=6000
MAX_IMAGE_FILES=5
JPEG_REENCODE_QUALITY=85
LOGIN_RATE_PER_MINUTE=10
SENSITIVE_RATE_PER_MINUTE=5
UPLOAD_RATE_PER_MINUTE=10
ADMIN_WRITE_RATE_PER_MINUTE=30

# Aktifkan bila ClamAV tersedia di server.
AV_SCAN_ENABLED=false
AV_SCAN_BINARY=clamscan
AV_SCAN_TIMEOUT=60

# Backup (digfin:backup) — dump DB + arsip file upload.
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=14
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
BACKUP_TIMEOUT=600
