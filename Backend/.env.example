APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Origin SPA React yang diizinkan (CORS). Pisahkan dengan koma.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Sanctum memaksa request stateful (cookie/session) dari domain ini.
# PENTING: format tanpa protokol, pisahkan dengan koma.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true hanya bila akses via HTTPS (production).
SESSION_SECURE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================================================
# SECURITY (lihat config/security.php)
# ==========================================================================
# Prefix route admin API (obscurity layer, bukan pengganti auth/authorization).
ADMIN_PATH=digfin-secure-panel

# Kredensial bootstrap admin awal (sekali pakai, DIPAKSA ganti saat login).
# JANGAN pernah mengisi nilai asli di .env.example / commit ke repo.
# ADMIN_INITIAL_USERNAME=
# ADMIN_INITIAL_PASSWORD=

ADMIN_MAX_DEVICES=2
ADMIN_SESSION_LIFETIME=120

LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_SHORT=1
LOGIN_COOLDOWN_MEDIUM=5
LOGIN_COOLDOWN_LONG=15
LOGIN_COOLDOWN_EXTENDED=30
LOGIN_USERNAME_PROBE_WINDOW=10
LOGIN_MAX_USERNAMES_PER_IP=10
LOGIN_IP_PROBE_WINDOW=15
LOGIN_MAX_IPS_PER_USERNAME=5

PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_HISTORY_COUNT=5

MAX_IMAGE_SIZE=5120
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_HEIGHT=6000
MAX_IMAGE_FILES=5
JPEG_REENCODE_QUALITY=85
LOGIN_RATE_PER_MINUTE=10
SENSITIVE_RATE_PER_MINUTE=5
UPLOAD_RATE_PER_MINUTE=10
ADMIN_WRITE_RATE_PER_MINUTE=30

AV_SCAN_ENABLED=false
AV_SCAN_BINARY=clamscan
AV_SCAN_TIMEOUT=60
