# Salin file ini ke ".env.docker" lalu isi nilai rahasianya.
#   copy .env.docker.example .env.docker   (Windows)
#   cp .env.docker.example .env.docker     (Unix)
# .env.docker TIDAK boleh di-commit (sudah masuk .gitignore).

# ==== Aplikasi ====
APP_NAME=DIGFIN
APP_ENV=production
APP_DEBUG=false
# GANTI dengan hasil: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:QcHjo6CF1W094Ges4g/dYkuKFL4Qno4ae2XFnG+Kq3c=
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# ==== Log (rotasi harian) ====
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
LOG_SECURITY_DAYS=30

# ==== Database (PostgreSQL) ====
# Nilai ini dipakai service `db` DAN service `app` — harus konsisten.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=digfin
DB_USERNAME=digfin
DB_PASSWORD=ubah-password-db-yang-kuat

# ==== Redis (cache/queue/session) ====
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ==== Frontend / Sanctum / CORS ====
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

# ==== Panel admin (harus sama dengan VITE_ADMIN_PATH saat build) ====
ADMIN_PATH=digfin-secure-panel
VITE_ADMIN_PATH=/digfin-secure-panel
ADMIN_MAX_DEVICES=2
ADMIN_SESSION_LIFETIME=120
ADMIN_LIST_PER_PAGE=15

# ==== Keamanan ringkas ====
LOGIN_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=12
MAX_IMAGE_SIZE=5120
AV_SCAN_ENABLED=false

# ==== Backup (digfin:backup) ====
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=14
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
BACKUP_TIMEOUT=600
